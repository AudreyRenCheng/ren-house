# Local/CI content sync only. Accepts a public Worker root or a full /api/songs URL.
SONGS_SYNC_API_URL=https://rens-house-api.YOUR_SUBDOMAIN.workers.dev

# Public, non-secret browser setting shared by the Pages and Hong Kong builds.
# Accepts the Analytics Worker custom-domain root or its full /api/events URL.
NEXT_PUBLIC_ANALYTICS_API_URL=https://analytics.YOUR_DOMAIN

# Cloudflare Pages Functions runtime variables; never exposed to browser JavaScript.
SONGS_API_URL=https://rens-house-api.YOUR_SUBDOMAIN.workers.dev
ADMIN_API_URL=https://rens-house-admin-api.YOUR_SUBDOMAIN.workers.dev
