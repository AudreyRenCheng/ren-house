name = "rens-house-api"
main = "src/index.ts"
compatibility_date = "2026-07-20"

[[d1_databases]]
binding = "SONGS_DB"
database_name = "rens-house-songs"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "SONGS_MEDIA"
bucket_name = "rens-house-media"

[vars]
ENVIRONMENT = "production"
ACCESS_TEAM_DOMAIN = "https://YOUR_TEAM.cloudflareaccess.com"
ACCESS_AUD = "REPLACE_WITH_ACCESS_APPLICATION_AUD"
ALLOWED_ORIGIN = "https://YOUR_PAGES_DOMAIN"
PUBLIC_MEDIA_BASE_URL = "https://YOUR_WORKER_OR_CUSTOM_DOMAIN"
